# Firebase Admin SDK credentials
# Download the service account JSON from:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Then either point to the file path OR paste values individually.

FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Server
PORT=5000

# Meal token price (in rupees) - used when purchasing a token
MEAL_TOKEN_PRICE=40

# Crowd alert threshold - dashboard/notification trigger
CROWD_ALERT_THRESHOLD=50
